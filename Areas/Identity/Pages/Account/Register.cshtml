@page
@model RegisterModel
@{
    ViewData["Title"] = "Rejestracja";
    ViewData["HideLoginPartial"] = true;
}

<link rel="stylesheet" href="/css/register.css" />

<div class="register-wrapper">
    <div class="register-card">
        <div class="register-header">
            <h1>🐟 Dołącz do Fischt</h1>
            <p>Znajdź swoją drugą połówkę w stawie</p>
        </div>

        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>

            <!-- Konto -->
            <div class="form-section">
                <h3>Dane konta</h3>
                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-input" placeholder="twoj@email.com" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Password">Hasło</label>
                        <input asp-for="Input.Password" class="form-input" placeholder="Min. 6 znaków" />
                        <span asp-validation-for="Input.Password" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword">Potwierdź hasło</label>
                        <input asp-for="Input.ConfirmPassword" class="form-input" placeholder="Powtórz hasło" />
                        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                    </div>
                </div>
            </div>

            <!-- Profil -->
            <div class="form-section">
                <h3>Twój profil</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Name">Imię</label>
                        <input asp-for="Input.Name" class="form-input" placeholder="Jak masz na imię?" />
                        <span asp-validation-for="Input.Name" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Age">Wiek</label>
                        <input asp-for="Input.Age" type="number" class="form-input" min="18" max="99" />
                        <span asp-validation-for="Input.Age" class="field-error"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Sex">Płeć biologiczna</label>
                        <select asp-for="Input.Sex" class="form-input">
                            <option value="">-- Wybierz --</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Input.Sex" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Gender">Tożsamość płciowa</label>
                        <input asp-for="Input.Gender" class="form-input"
                               placeholder="np. kobieta, niebinarne..." />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Pronouns">Zaimki</label>
                        <select asp-for="Input.Pronouns" class="form-input">
                            <option value="">-- Wybierz --</option>
                            <option value="ona/jej">ona/jej</option>
                            <option value="on/jego">on/jego</option>
                            <option value="ono/jego">ono/jego</option>
                            <option value="oni/ich">oni/ich</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.SpecieId">Gatunek</label>
                        <select asp-for="Input.SpecieId" class="form-input"
                                asp-items="Model.SpeciesList">
                            <option value="">-- Wybierz --</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Bio">O sobie</label>
                    <textarea asp-for="Input.Bio" class="form-input form-textarea"
                              rows="3" placeholder="Kilka słów o sobie..."></textarea>
                </div>
            </div>

            <button type="submit" class="btn-register">Zarejestruj się</button>

            <p class="login-link">
                Masz już konto?
                <a asp-area="Identity" asp-page="/Account/Login">Zaloguj się</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}