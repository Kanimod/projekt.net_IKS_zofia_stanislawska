@page

@{
    ViewData["Title"] = "About";
}
<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<div class="background"></div>
    <div class="text">
        <div class="text-content">
            <h1>Welcome to Fischt</h1>
            <p>
                Discover a community built for aquarium enthusiasts,
                fish keepers and aquatic life lovers.
            </p>
        </div>
    </div>

    <div class="about-div">
        <div class="about-text">
            <h2>Our Mission</h2>

            <p>
                Fischt connects people who share a passion for aquariums and fish.
                We believe that common interests create meaningful friendships
                and lasting relationships.
            </p>

            <p>
                Our platform allows users to create profiles, exchange messages,
                discover new people and become part of a growing community.
            </p>
        </div>

        <div class="about-image">
            <img src="/images/kissing-fish.png" alt="Aquarium">
        </div>
    </div>


