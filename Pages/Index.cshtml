@page
@model IndexModel

<h1>Użytkownicy</h1>

<form method="post">
    <input type="text" name="username" placeholder="Username" required />
    <button type="submit">Dodaj użytkownika</button>
</form>

<ul>
    @foreach (var user in Model.Users)
    {
        <li>@user.Username - @user.Mail</li>
    }
</ul>