@page
@using Microsoft.AspNetCore.Identity
@using Fischt.Models

@inject SignInManager<User> SignInManager

@if (User.IsInRole("Admin"))
{
    <h1>Panel administratora</h1>
    <p>Tu masz pełną kontrolę, statystyki, zarządzanie użytkownikami.</p>
}
else if (SignInManager.IsSignedIn(User))
{
    <h1>Witaj, @User.Identity.Name!</h1>
    <p>To jest strona główna dla zwykłego użytkownika.</p>
}
else
{
    <h1>Witaj, gościu!</h1>
    <p>Zaloguj się, aby poznać innych wędkarzy.</p>
}