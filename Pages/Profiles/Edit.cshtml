@page
@model Fischt.Pages.Profiles.EditModel
@{
    ViewData["Title"] = "Edit profile";
}

<link rel="stylesheet" href="/css/edit-profile.css" />

<div class="edit-container">
    <h2>Edit profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    <form method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="Profile.Id" />
        <input type="hidden" asp-for="Profile.UserId" />
        <input type="hidden" asp-for="Profile.PhotoPath" />

        <div class="photo-section">
            @if (!string.IsNullOrEmpty(Model.Profile.PhotoPath))
            {
                <img src="@Model.Profile.PhotoPath" class="photo-preview" alt="Profile photo" />
            }
            else
            {
                <div class="photo-placeholder">:3</div>
            }

            <div class="photo-upload">
                <label for="PhotoUpload" class="upload-label">
                     Change photo
                </label>
                <input type="file"
                       id="PhotoUpload"
                       name="PhotoUpload"
                       accept="image/jpeg,image/png,image/webp"
                       class="upload-input"
                       onchange="previewPhoto(this)" />
                <p class="upload-hint">JPG, PNG or WebP</p>
            </div>
        </div>

        <!-- Pola formularza -->
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Profile.Name">Name</label>
                <input asp-for="Profile.Name" class="form-control" placeholder="Your name" />
            </div>

            <div class="form-group">
                <label asp-for="Profile.Age">Age</label>
                <input asp-for="Profile.Age" type="number" class="form-control" min="18" max="99" />
            </div>

            <div class="form-group full-width">
                <label asp-for="Profile.Bio">About me</label>
                <textarea asp-for="Profile.Bio" class="form-control" rows="3"
                          placeholder="A few words about yourself..."></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Profile.Sex">Biological sex</label>
                <select asp-for="Profile.Sex" class="form-control">
                    <option value="">-- Select --</option>
                    <option value="Female">Female</option>
                    <option value="Male">Male</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Profile.Gender">Gender identity</label>
                <input asp-for="Profile.Gender" class="form-control"
                    placeholder="e.g., woman, man, non-binary..." />
            </div>

            <div class="form-group">
                <label asp-for="Profile.Pronouns">Pronouns</label>
                <input asp-for="Profile.Pronouns" class="form-control" placeholder="e.g., she/her, he/him, they/them" />
            </div>

            <div class="form-group">
                <label asp-for="Profile.Preferences">Preferences</label>
                <input asp-for="Profile.Preferences" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Profile.SpecieId">Gatunek</label>
                <select asp-for="Profile.SpecieId" class="form-control"
                        asp-items="Model.SpeciesList">
                    <option value="">-- Select --</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Profile.Length">Length (cm)</label>
                <input asp-for="Profile.Length" type="number" step="0.1" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">Save changes</button>
        </div>

        <span asp-validation-for="Profile.Name" class="text-danger"></span>
    </form>
</div>

<script>
    function previewPhoto(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                const preview = document.querySelector('.photo-preview, .photo-placeholder');
                if (preview) {
                    preview.outerHTML = `<img src="${e.target.result}" class="photo-preview" alt="Podgląd" />`;
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>